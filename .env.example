# ====================================
# AI Landing Page Generator — 环境变量
# ====================================
# 复制此文件为 .env.local 并填入实际值:
#   cp .env.example .env.local
#
# 所有变量说明:
#
# [必需] API Key
#   - OpenAI:  https://platform.openai.com/api-keys  (格式 sk-...)
#   - DeepSeek: https://platform.deepseek.com/api_keys (格式 sk-...)
OPENAI_API_KEY=sk-...

# [可选] 自定义 API 端点（使用 DeepSeek 等兼容服务时设置）
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# [可选] 模型名称（默认 gpt-4o，DeepSeek 用 deepseek-chat）
# OPENAI_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.openai.com/v1
